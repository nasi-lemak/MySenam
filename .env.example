# Copy to .env.local and change what you need. In development everything has
# a working default, so MySenam runs with none of it set. In production,
# ADMIN_PASSWORD is required, and MYSENAM_URL, a database and a way to send
# email are needed for anything real.
#
# Every variable the app reads is here, commented out. What each one does in
# full is in docs/development/configuration.md, which is the authoritative list.

# ---------------------------------------------------------------- the install

# The country this install serves: MY (default) or SG. Currency, phone
# numbers, time zone, languages, map, default payment gateway and the laws the
# terms cite follow it.
# MYSENAM_COUNTRY=MY

# What the site calls itself. A venue business's own copy uses its own name.
# SITE_NAME=MySenam

# Where this install is reachable, for the links inside customer messages and
# Google sign-in. Without it they point at localhost.
# MYSENAM_URL=https://book.yourvenue.my

# Only behind a proxy that rewrites Host: read a storefront's own domain from
# X-Forwarded-Host.
# MYSENAM_TRUST_FORWARDED_HOST=on

# Force the Secure flag on session cookies, for a proxy that sets no
# X-Forwarded-Proto.
# SECURE_COOKIES=1

# Where venue addresses are looked up: a Nominatim URL of your own, or off.
# MYSENAM_GEOCODER=https://nominatim.openstreetmap.org

# ------------------------------------------------------------- the first owner

# The first platform owner, created on a fresh database.
# ADMIN_EMAIL=admin@mysenam.my
# Required in production: at least 12 characters and not the published
# development default, or no owner is made and the default is refused at
# sign-in. Unset in development, the default is used.
# ADMIN_PASSWORD=

# Make two-factor sign-in compulsory for staff: owners, managers or all.
# MYSENAM_STAFF_2FA=managers

# ------------------------------------------------------------------ marketplace

# The shared marketplace: venues apply to join and stored credit is per venue.
# Leave unset for one business's own copy.
# MYSENAM_MARKETPLACE=on
# MYSENAM_CREDIT_SCOPE=venue
#
# Approve a business's new branch without the platform owner, when its
# location checks pass.
# MYSENAM_AUTO_APPROVE_BRANCHES=on
#
# What venues pay a month (unless they have their own fee or tiers are set),
# invoiced on the first of each month, and free months after going live.
# MYSENAM_VENUE_FEE=0
# MYSENAM_FREE_MONTHS=1
#
# WhatsApp messages in a prepaid pack, and its price.
# MYSENAM_WHATSAPP_PACK=200
# MYSENAM_WHATSAPP_PACK_PRICE=20
#
# The operator's own SST or GST, once registered: added to venues' invoices.
# Both the rate and the number, or no tax. MYSENAM_TAX_NAME overrides SST/GST.
# MYSENAM_TAX_RATE=8
# MYSENAM_TAX_REG_NO=W10-0000-00000000
# MYSENAM_TAX_NAME=SST

# Who runs the site, shown in the terms at /terms; name, address and email
# are also who to write to in the privacy notice at /privacy (PDPA).
# OPERATOR_NAME=
# OPERATOR_REG_NO=
# OPERATOR_ADDRESS=
# OPERATOR_EMAIL=

# ------------------------------------------------------------------- payments

# Payment gateways venues may connect (comma-separated: billplz, stripe), and
# the one the platform's own account is at. Default: the country's usual one.
# MYSENAM_PAYMENT_PROVIDERS=billplz
# MYSENAM_PAYMENT_PROVIDER=billplz
#
# The platform's own account, which venues pay invoices and WhatsApp packs
# into. Not a venue's: venues enter their own under Venues & staff → Online
# payment. Billplz:
# BILLPLZ_API_KEY=
# BILLPLZ_COLLECTION_ID=
# BILLPLZ_X_SIGNATURE_KEY=
# BILLPLZ_SANDBOX=on
# Or Stripe (its webhook also takes charge.dispute.* events):
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# The platform's own MyInvois ERP client, to act as venues' intermediary for
# LHDN e-invoicing (Malaysia).
# MYINVOIS_CLIENT_ID=
# MYINVOIS_CLIENT_SECRET=

# Encrypts the payment keys venues enter. Unset, a key is generated into
# secret.key in the data folder (never in the database, so backups carry the
# locked keys without what unlocks them). Set it, the same on every instance,
# to keep payment keys working on another machine.
# MYSENAM_SECRET=

# -------------------------------------------------------------------- database

# In production, a Postgres server (16 or later):
# DATABASE_URL=postgres://mysenam:password@127.0.0.1:5432/mysenam
# Unset, it is PGlite — Postgres inside the app — in data/pglite: fine for
# development, but about a gigabyte of memory. pglite:/some/folder puts it
# elsewhere; pglite:memory keeps nothing.
# DATABASE_POOL_SIZE=10
#
# The app's own folder: backups, and secret.key when MYSENAM_SECRET is unset.
# Put it on a disk that survives a redeploy.
# MYSENAM_DATA_DIR=/var/lib/mysenam
#
# :memory: runs on an in-memory PGlite (what the test suite uses).
# MYSENAM_DB=:memory:

# -------------------------------------------------------------------- backups

# Where backups are written (default: backups/ in the data folder), and how
# many are kept. On a Postgres server they are taken with pg_dump, which must
# be installed where the app runs (apt install postgresql-client).
# MYSENAM_BACKUP_DIR=/var/backups/mysenam
# MYSENAM_BACKUP_KEEP=14
# MYSENAM_PG_DUMP=/usr/bin/pg_dump
# MYSENAM_PG_RESTORE=/usr/bin/pg_restore
#
# One is taken every night at this hour, in the install country's time. Set
# MYSENAM_SCHEDULER=off to run the scheduled work (and `npm run backup`) from
# your own cron instead.
# MYSENAM_BACKUP_HOUR=3
# MYSENAM_SCHEDULER=off
#
# The newest copy that would survive losing the server may be this many hours
# old before the owners are alerted (docs/operations/backups.md#backup-health).
# MYSENAM_BACKUP_RPO_HOURS=26
#
# Supporting documents sent with applications are scanned for malware by
# ClamAV's daemon (clamd) before anybody can open them; without one they wait
# in quarantine, unopened (docs/operations/deployment.md#the-malware-scanner).
# MYSENAM_CLAMD=127.0.0.1:3310
# There is no opt-out. The former MYSENAM_DOCUMENT_SCAN=off was withdrawn and
# is ignored, with a start-up warning while it is set: remove it.
# MYSENAM_DOCUMENT_SCAN=
#
# And copied off the machine, to any S3-compatible storage: Backblaze B2 is
# preferred, Amazon S3 is supported as well (docs/integrations/launch-providers.md).
# This key should only upload; protect earlier copies with Object Lock
# (docs/operations/backups.md#keys-and-object-lock). The endpoint is the one
# the provider shows for the bucket; the signing region is read from it for
# B2 and S3, so OFFSITE_S3_REGION is needed only for other providers.
# OFFSITE_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# OFFSITE_S3_BUCKET=venue-backups
# OFFSITE_S3_REGION=
# OFFSITE_S3_ACCESS_KEY_ID=
# OFFSITE_S3_SECRET_ACCESS_KEY=
# OFFSITE_S3_PREFIX=mysenam/
# The country the bucket keeps data in. Nothing is sent until it is set, or
# while it disagrees with the country the endpoint names; a country other than
# MYSENAM_COUNTRY also needs the transfer approved (the same code) and
# encryption on (docs/architecture/privacy.md#backups-held-abroad).
# OFFSITE_DATA_LOCATION=US
# OFFSITE_TRANSFER_APPROVED=
# Encrypt each copy before it leaves: the server holds only the public key.
# OFFSITE_ENCRYPTION_PUBLIC_KEY_FILE=/etc/mysenam/offsite-public.pem
# Sign each set's manifest, so a set uploaded by somebody holding only the
# upload key is told apart (an Ed25519 private key, a file readable by the app).
# OFFSITE_SIGNING_KEY_FILE=/etc/mysenam/offsite-signing.pem
# On the machine you restore from, never the server: the read key, the
# private key and the signing public key (scripts/fetch-backup.mjs).
# OFFSITE_S3_READ_ACCESS_KEY_ID=
# OFFSITE_S3_READ_SECRET_ACCESS_KEY=
# OFFSITE_ENCRYPTION_PRIVATE_KEY_FILE=
# OFFSITE_SIGNING_PUBLIC_KEY_FILE=
# The erasure ledger (numbers of erased accounts, no names) also goes
# off-site, signed and encrypted like the sets: by default to the same bucket
# under erasure-ledger/ with the same keys. A bucket and upload-only key of
# its own, on the same endpoint, where wanted
# (docs/operations/backups.md#the-erasure-ledger-off-site):
# OFFSITE_LEDGER_S3_BUCKET=
# OFFSITE_LEDGER_S3_PREFIX=
# OFFSITE_LEDGER_S3_ACCESS_KEY_ID=
# OFFSITE_LEDGER_S3_SECRET_ACCESS_KEY=
# And, on the restore machine only, its read key:
# OFFSITE_LEDGER_S3_READ_ACCESS_KEY_ID=
# OFFSITE_LEDGER_S3_READ_SECRET_ACCESS_KEY=

# -------------------------------------------------------------- venue photos

# A bucket of its own for venue photos; without one they go in the data folder.
# PHOTOS_S3_ENDPOINT=
# PHOTOS_S3_BUCKET=
# PHOTOS_S3_REGION=auto
# PHOTOS_S3_ACCESS_KEY_ID=
# PHOTOS_S3_SECRET_ACCESS_KEY=
# Its public address, so browsers fetch photos from it directly.
# PHOTOS_PUBLIC_URL=

# ------------------------------------------------------------------- messages

# Messages are always written down, and the admin panel shows them; nothing
# leaves the machine until one of the ways below is set. `log` writes each to
# the server log instead and marks it sent, for development.
# MYSENAM_SEND=log
#
# Email, through any SMTP account. Confirmations go by email.
# SMTP_URL=smtp://user:password@smtp.example.com:587
# MAIL_FROM=Arena Bookings <bookings@example.com>
#
# WhatsApp Cloud API. Its templates must be approved by Meta first (see
# docs/integrations/whatsapp-templates.md).
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_PREFIX=mysenam
# WHATSAPP_CODE_TEMPLATE=mysenam_login_code
# WHATSAPP_COUNTRY_CODE=60
# WHATSAPP_API_VERSION=v23.0
#
# So customers can send a confirmation to their own WhatsApp: the platform's
# number as dialled, the Meta app's secret, and a token for the webhook.
# WHATSAPP_CHAT_NUMBER=+60 11-2345 6789
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# MYSENAM_WHATSAPP_CHAT_HOLD_MINUTES=3

# ------------------------------------------------------ checking phone numbers

# off to take numbers as given; on to check them even with no way set up.
# MYSENAM_PHONE_CHECK=on
# MYSENAM_PHONE_CODES_PER_DAY=300
#
# Codes by SMS, through Twilio:
# SMS_TWILIO_ACCOUNT_SID=
# SMS_TWILIO_AUTH_TOKEN=
# SMS_FROM=
# Or any gateway that sends with one GET ({to} and {text} are filled in):
# SMS_HTTP_URL=https://gateway.example.my/send?to={to}&text={text}
# What every SMS starts with (RM0 in Malaysia); empty to leave it off.
# SMS_PREFIX=RM0

# ----------------------------------------------------------- Google sign-in

# Redirect to register with Google: <MYSENAM_URL>/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------ running it

# Shared rate-limit counters in Postgres, for more than one instance.
# MYSENAM_RATE_LIMITS=shared
#
# Errors also to Sentry or GlitchTip, and alerts to a Slack, Discord or
# Google Chat incoming webhook as well as by email.
# SENTRY_DSN=
# MYSENAM_ALERT_WEBHOOK=

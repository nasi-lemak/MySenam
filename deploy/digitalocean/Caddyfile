# MySenam behind Caddy. Installed to /etc/caddy/Caddyfile by setup.sh, which
# fills in __DOMAIN__ and __ACME_EMAIL__.
#
# Caddy gets and renews every certificate by itself: the install's own
# address up front, and each storefront's domain on its first visit — but only
# once the app has said, at /api/tls-check, that the domain is one of its
# storefronts.
{
	email __ACME_EMAIL__

	on_demand_tls {
		ask http://127.0.0.1:3000/api/tls-check
	}

	# With the domain proxied through Cloudflare (orange cloud), every request
	# arrives from a Cloudflare address. Uncomment this so Caddy takes the
	# visitor's own address from Cloudflare's header — and only from
	# Cloudflare — or every visitor shares one rate limit. The ranges are
	# https://www.cloudflare.com/ips/ and change rarely.
	#
	# servers {
	# 	trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	# 	client_ip_headers CF-Connecting-IP
	# }
}

(app) {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000 {
		# One address, the one Caddy trusts — not whatever the visitor put in
		# the header themselves. The app limits login attempts by it.
		header_up X-Forwarded-For {client_ip}
		header_up X-Real-IP {client_ip}
	}
}

__DOMAIN__ {
	import app
}

# Everything else: storefront domains, and www. of any of them.
https:// {
	tls {
		on_demand
	}
	import app
}

# Plain http:// is redirected to https:// by Caddy without being asked.

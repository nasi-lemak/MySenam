{
  "name": "mysenam",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MySenam - online booking for badminton, tennis, pickleball and futsal courts, gyms, pools and classes",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "fetch-backup": "node scripts/fetch-backup.mjs",
    "verify-offsite": "node scripts/verify-offsite.mjs",
    "import-sqlite": "node scripts/import-sqlite.mjs",
    "coverage": "vitest run --coverage",
    "docs:check": "vitest run tests/docs.test.ts",
    "e2e": "vitest run --config vitest.e2e.config.mts",
    "bench": "vitest run --config vitest.bench.config.mts",
    "verify": "node scripts/verify.mjs",
    "stage": "node scripts/stage.mjs",
    "uat": "vitest run --config vitest.uat.config.mts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@photostructure/tz-lookup": "11.7.0",
    "better-sqlite3": "^11.10.0",
    "leaflet": "^1.9.4",
    "next": "^15.5.2",
    "nodemailer": "^10.1.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.1.12",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "jsdom": "^30.1.1",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "postcss": "^8.5.28"
  }
}
